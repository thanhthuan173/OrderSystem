@page "/"

@inject OrdersApiClient OrdersApi
@inject InventoryApiClient InventoryApi

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<div class="mb-3">
    <button
            @onclick="RefreshAsync"
            disabled="@_isLoading">
        @(_isLoading ? "Refreshing..." : "Refresh")
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

<div class="row">
    <div class="col-md-7">
        <h3>Recent Orders</h3>

        @if (_orders.Count == 0)
        {
            <p>No orders found.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Created At</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in _orders)
                    {
                        <tr>
                            <td>
                                @order.OrderId
                            </td>

                            <td>
                                @order.Status
                            </td>

                            <td>
                                @order.TotalAmount.ToString("F2")
                            </td>

                            <td>
                                @order.CreatedAt.ToLocalTime()
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-md-5">
        <h3>Current Stock</h3>

        @if (_stockItems.Count == 0)
        {
            <p>No stock found.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>On Hand</th>
                        <th>Reserved</th>
                        <th>Available</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in _stockItems)
                    {
                        <tr>
                            <td>@item.Sku</td>
                            <td>@item.QuantityOnHand</td>
                            <td>@item.QuantityReserved</td>
                            <td>@item.Available</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>