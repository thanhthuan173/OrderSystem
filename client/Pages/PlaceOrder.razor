@page "/place-order"

@implements IDisposable

@inject OrdersApiClient OrdersApi
@inject InventoryApiClient InventoryApi

<PageTitle>Place Order</PageTitle>

<h1>Place Order</h1>

@if (_isLoadingStock)
{
    <p>Loading stock...</p>
}
else if (_stockItems.Count == 0)
{
    <p>No stock items available.</p>
}
else
{
    <div class="mb-3">
        <label for="customerId">Customer ID</label>

        <input id="customerId"
               class="form-control"
               @bind="_orderRequest.CustomerId"
               @bind:event="oninput" />
    </div>

    <h3>Order Lines</h3>

    @foreach (var line in _orderRequest.Lines)
    {
        <div class="row mb-2">
            <div class="col-md-4">
                <label>SKU</label>

                <select class="form-select"
                        @bind="line.Sku">
                    @foreach (var stockItem in _stockItems)
                    {
                        <option value="@stockItem.Sku">
                            @stockItem.Sku
                            (Available: @stockItem.Available)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label>Quantity</label>

                <input type="number"
                       class="form-control"
                       min="1"
                       @bind="line.Quantity" />
            </div>

            <div class="col-md-2">
                <label>Unit Price</label>

                <input type="number"
                       class="form-control"
                       min="0.01"
                       step="0.01"
                       @bind="line.UnitPrice" />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="button"
                        @onclick="() => RemoveLine(line)"
                        disabled="@(_orderRequest.Lines.Count == 1)">
                    Remove
                </button>
            </div>
        </div>
    }

    <div class="mb-3">
        <button type="button"
                @onclick="AddLine">
            Add SKU
        </button>
    </div>

    <button
            @onclick="PlaceOrderAsync"
            disabled="@(_isSubmitting || _isPolling)">
        @(_isSubmitting ? "Placing..." : "Place Order")
    </button>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger mt-3">
        @_errorMessage
    </div>
}

@if (_createdOrder is not null)
{
    <div class="card mt-4">
        <div class="card-body">
            <h3>Order Progress</h3>

            <p>
                <strong>Order ID:</strong>
                @_createdOrder.OrderId
            </p>

            <p>
                <strong>Status:</strong>
                @_createdOrder.Status
            </p>

            @if (_orderDetail is not null)
            {
                <hr />

                <p>
                    <strong>Reservation:</strong>
                    @(_orderDetail.ReservationCompleted
                        ? "Completed"
                        : "Not completed")
                </p>

                <p>
                    <strong>Payment:</strong>
                    @(_orderDetail.PaymentCompleted
                        ? "Completed"
                        : "Not completed")
                </p>

                <p>
                    <strong>Total:</strong>
                    @_orderDetail.TotalAmount.ToString("F2")
                </p>
            }

            @if (_isPolling)
            {
                <p>Waiting for saga to complete...</p>
            }
        </div>
    </div>
}